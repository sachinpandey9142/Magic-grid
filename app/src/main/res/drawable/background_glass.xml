<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/glass_medium" />
            <corners android:radius="30dp" />
        </shape>
    </item>

    <item
        android:gravity="top"
        android:height="1dp"
        android:left="1dp"
        android:right="1dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="0"
                android:startColor="#B300FF"
                android:centerColor="#FF1493"
                android:endColor="#0099FF" />
            <corners
                android:topLeftRadius="30dp"
                android:topRightRadius="30dp"
                android:bottomLeftRadius="0dp"
                android:bottomRightRadius="0dp" />
        </shape>
    </item>

    <item
        android:gravity="bottom"
        android:height="1dp"
        android:left="1dp"
        android:right="1dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="0"
                android:startColor="#0099FF"
                android:centerColor="#FF6B00"
                android:endColor="#B300FF" />
            <corners
                android:topLeftRadius="0dp"
                android:topRightRadius="0dp"
                android:bottomLeftRadius="30dp"
                android:bottomRightRadius="30dp" />
        </shape>
    </item>

    <item
        android:gravity="left"
        android:width="1dp"
        android:top="1dp"
        android:bottom="1dp">
        <shape android:shape="rectangle">
            <solid android:color="#B300FF" />
        </shape>
    </item>

    <item
        android:gravity="right"
        android:width="1dp"
        android:top="1dp"
        android:bottom="1dp">
        <shape android:shape="rectangle">
            <solid android:color="#0099FF" />
        </shape>
    </item>

</layer-list>
