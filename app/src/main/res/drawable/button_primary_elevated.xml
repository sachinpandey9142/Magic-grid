<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Shadow/glow layer -->
    <item
        android:left="0dp"
        android:right="0dp"
        android:top="0dp"
        android:bottom="4dp">
        <shape android:shape="rectangle">
            <solid android:color="#7C3AED4D" />
            <corners android:radius="20dp" />
        </shape>
    </item>
    <!-- Main button -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="90"
                android:startColor="@color/primary"
                android:endColor="@color/primary_dark" />
            <corners android:radius="20dp" />
            <stroke
                android:width="2dp"
                android:color="@color/primary_light" />
            <padding
                android:bottom="16dp"
                android:left="32dp"
                android:right="32dp"
                android:top="16dp" />
        </shape>
    </item>
</layer-list>
