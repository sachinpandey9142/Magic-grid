<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <solid android:color="#52FFFFFF" />
            <size
                android:width="10dp"
                android:height="10dp" />
        </shape>
    </item>

    <item
        android:left="1dp"
        android:top="1dp"
        android:right="1dp"
        android:bottom="1dp">
        <shape android:shape="oval">
            <gradient
                android:type="radial"
                android:gradientRadius="5dp"
                android:centerColor="#F6FCFF"
                android:endColor="#8BD7FF" />
            <stroke
                android:width="1dp"
                android:color="#CCFFFFFF" />
        </shape>
    </item>
</layer-list>
