<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:top="5dp">
        <shape android:shape="rectangle">
            <solid android:color="#7D05091E" />
            <corners android:radius="28dp" />
        </shape>
    </item>

    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="270"
                android:startColor="#45FFFFFF"
                android:endColor="#D9111D3A" />
            <stroke
                android:width="1dp"
                android:color="@color/menu_panel_border" />
            <corners android:radius="28dp" />
        </shape>
    </item>

    <item
        android:left="1dp"
        android:top="1dp"
        android:right="1dp"
        android:bottom="124dp">
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="90"
                android:startColor="#35FFFFFF"
                android:endColor="#00FFFFFF" />
            <corners android:radius="28dp" />
        </shape>
    </item>

    <item
        android:left="12dp"
        android:right="12dp"
        android:top="10dp"
        android:bottom="10dp">
        <shape android:shape="rectangle">
            <stroke
                android:width="1dp"
                android:color="#35B1D8FF" />
            <corners android:radius="22dp" />
        </shape>
    </item>
</layer-list>