<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <layer-list>
            <item android:top="4dp">
                <shape android:shape="rectangle">
                    <solid android:color="#50182A" />
                    <corners android:radius="22dp" />
                </shape>
            </item>
            <item android:bottom="3dp">
                <shape android:shape="rectangle">
                    <gradient
                        android:type="linear"
                        android:angle="90"
                        android:startColor="#FF6B88"
                        android:endColor="#B33756" />
                    <stroke
                        android:width="2dp"
                        android:color="#FFE0E8" />
                    <corners android:radius="22dp" />
                </shape>
            </item>

            <item
                android:left="2dp"
                android:top="2dp"
                android:right="2dp"
                android:bottom="58dp">
                <shape android:shape="rectangle">
                    <gradient
                        android:type="linear"
                        android:angle="90"
                        android:startColor="#52FFFFFF"
                        android:endColor="#00FFFFFF" />
                    <corners android:radius="22dp" />
                </shape>
            </item>
        </layer-list>
    </item>

    <item>
        <layer-list>
            <item android:top="4dp">
                <shape android:shape="rectangle">
                    <solid android:color="#39141F" />
                    <corners android:radius="22dp" />
                </shape>
            </item>
            <item android:bottom="2dp">
                <shape android:shape="rectangle">
                    <gradient
                        android:type="linear"
                        android:angle="90"
                        android:startColor="#C6405E"
                        android:endColor="#85263E" />
                    <stroke
                        android:width="1dp"
                        android:color="#A8FFB3C2" />
                    <corners android:radius="22dp" />
                </shape>
            </item>

            <item
                android:left="2dp"
                android:top="2dp"
                android:right="2dp"
                android:bottom="60dp">
                <shape android:shape="rectangle">
                    <gradient
                        android:type="linear"
                        android:angle="90"
                        android:startColor="#3DFFFFFF"
                        android:endColor="#00FFFFFF" />
                    <corners android:radius="22dp" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
