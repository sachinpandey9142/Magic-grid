<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- ===== MAIN APP THEME (Dark Mode) ===== -->
    <style name="Theme.MagicGrid" parent="Theme.AppCompat.NoActionBar">
        <!-- Primary brand color -->
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryDark">@color/primary_dark</item>
        <item name="colorAccent">@color/secondary</item>

        <!-- Window properties -->
        <item name="android:windowBackground">@color/background</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowFullscreen">false</item>
        <item name="android:windowActionBar">false</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>

        <!-- Status bar - immersive dark mode -->
        <item name="android:statusBarColor">@color/background_dark</item>
        <item name="android:windowLightStatusBar">false</item>
        
        <!-- Navigation bar -->
        <item name="android:navigationBarColor">@color/background_dark</item>

        <!-- Text properties -->
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>

        <!-- Button properties -->
        <item name="android:buttonStyle">@style/Button</item>

        <!-- Default text appearance -->
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <!-- ===== BUTTON STYLES ===== -->
    <style name="Button" parent="Widget.AppCompat.Button">
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">16sp</item>
        <item name="android:padding">12dp</item>
    </style>

    <!-- Premium Button with Gradient -->
    <style name="ButtonPremium" parent="Button">
        <item name="android:minHeight">56dp</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:elevation">8dp</item>
    </style>

    <!-- Secondary Button -->
    <style name="ButtonSecondary" parent="Button">
        <item name="android:minHeight">48dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:elevation">4dp</item>
    </style>

    <!-- Icon Button (for game controls) -->
    <style name="ButtonIcon" parent="Button">
        <item name="android:minWidth">56dp</item>
        <item name="android:minHeight">56dp</item>
        <item name="android:padding">0dp</item>
    </style>

    <!-- ===== TEXT STYLES ===== -->
    <style name="Title">
        <item name="android:textSize">48sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:letterSpacing">0.05</item>
    </style>

    <style name="TitleLarge">
        <item name="android:textSize">56sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/primary</item>
        <item name="android:letterSpacing">0.08</item>
    </style>

    <style name="Subtitle">
        <item name="android:textSize">18sp</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:alpha">0.85</item>
    </style>

    <style name="Body">
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="BodySmall">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/text_secondary</item>
    </style>

    <style name="BodyTiny">
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/text_tertiary</item>
    </style>

    <!-- ===== DIALOG STYLES ===== -->
    <style name="DialogAnimation" parent="Base.Theme.AppCompat.Light.Dialog">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:backgroundDimAmount">0.6</item>
    </style>

    <!-- ===== CONTAINER STYLES ===== -->
    <style name="CardStyle">
        <item name="android:elevation">8dp</item>
        <item name="android:background">@color/surface</item>
    </style>

    <style name="GlassEffect">
        <item name="android:background">@color/glass_medium</item>
        <item name="android:elevation">4dp</item>
    </style>
</resources>
