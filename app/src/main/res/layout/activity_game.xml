<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- COSMIC BACKGROUND -->
    <com.magicgrid.ui.CosmicBackgroundView
        android:id="@+id/cosmic_background"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- MAIN CONTENT VERTICAL LAYOUT -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- ===== TOP BAR (Floating Glass Container) ===== -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/background_glass"
            android:elevation="8dp"
            android:layout_margin="12dp"
            android:layout_marginBottom="8dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="16dp"
                android:gravity="center_vertical">

                <!-- Back/Menu Button -->
                <Button
                    android:id="@+id/btn_back_top"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@drawable/button_icon"
                    android:text="←"
                    android:textSize="24sp"
                    android:textColor="@color/primary"
                    android:elevation="0dp"
                    android:padding="0dp" />

                <!-- Center Info -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="16dp">

                    <TextView
                        android:id="@+id/level_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Level 1: Challenge"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_primary" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="4dp">

                        <!-- Timer -->
                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginEnd="12dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="⏱"
                                android:textSize="14sp"
                                android:textColor="@color/secondary"
                                android:layout_marginEnd="4dp" />

                            <TextView
                                android:id="@+id/timer_text"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="00:00"
                                android:textSize="12sp"
                                android:textColor="@color/text_secondary" />

                        </LinearLayout>

                        <!-- Moves -->
                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="◆"
                                android:textSize="14sp"
                                android:textColor="@color/accent_cool"
                                android:layout_marginEnd="4dp" />

                            <TextView
                                android:id="@+id/move_counter"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="0"
                                android:textSize="12sp"
                                android:textColor="@color/text_secondary" />

                        </LinearLayout>

                    </LinearLayout>

                </LinearLayout>

                <!-- Pause Button -->
                <Button
                    android:id="@+id/btn_pause"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@drawable/button_icon"
                    android:text="⏸"
                    android:textSize="20sp"
                    android:textColor="@color/secondary"
                    android:elevation="0dp"
                    android:padding="0dp" />

            </LinearLayout>

        </FrameLayout>

        <!-- STAR TARGET TIMES (Floating Glass Container) -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/background_glass"
            android:layout_margin="12dp"
            android:layout_marginTop="0dp"
            android:layout_marginBottom="8dp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:layout_weight="1">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="⭐"
                        android:textSize="16sp" />

                    <TextView
                        android:id="@+id/target_text_1"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Complete"
                        android:textSize="10sp"
                        android:textColor="@color/text_tertiary" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:layout_weight="1">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="⭐⭐"
                        android:textSize="16sp" />

                    <TextView
                        android:id="@+id/target_text_2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="00:00"
                        android:textSize="10sp"
                        android:textColor="@color/text_tertiary" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:layout_weight="1">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="⭐⭐⭐"
                        android:textSize="16sp" />

                    <TextView
                        android:id="@+id/target_text_3"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="No hints"
                        android:textSize="10sp"
                        android:textColor="@color/text_tertiary" />

                </LinearLayout>

            </LinearLayout>

        </FrameLayout>

        <!-- GAME VIEW (Main Play Area) -->
        <com.magicgrid.ui.GameView
            android:id="@+id/game_view"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_margin="16dp"
            android:background="@android:color/transparent" />

        <!-- ===== BOTTOM CONTROL BUTTONS (Floating Glass Container) ===== -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/background_glass"
            android:elevation="8dp"
            android:layout_margin="12dp"
            android:layout_marginTop="8dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="10dp"
                android:gravity="center_vertical">

                <!-- Reset Button - Pink/Red Gradient with Glow -->
                <Button
                    android:id="@+id/btn_reset"
                    android:layout_width="0dp"
                    android:layout_height="74dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    android:minHeight="0dp"
                    android:minWidth="0dp"
                    android:text="@string/reset"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textAllCaps="false"
                    android:fontFamily="sans-serif-black"
                    android:textColor="@android:color/white"
                    android:background="@drawable/button_reset_premium"
                    android:drawableTop="@drawable/ic_reset"
                    android:drawableTint="@color/white"
                    android:drawablePadding="4dp"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:elevation="12dp"
                    android:stateListAnimator="@animator/button_animator"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp" />

                <!-- Undo Button - Blue/Cyan Gradient with Glow -->
                <Button
                    android:id="@+id/btn_undo"
                    android:layout_width="0dp"
                    android:layout_height="74dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    android:minHeight="0dp"
                    android:minWidth="0dp"
                    android:text="@string/undo"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textAllCaps="false"
                    android:fontFamily="sans-serif-black"
                    android:textColor="@android:color/white"
                    android:background="@drawable/button_undo_premium"
                    android:drawableTop="@drawable/ic_undo"
                    android:drawableTint="@color/white"
                    android:drawablePadding="4dp"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:elevation="12dp"
                    android:stateListAnimator="@animator/button_animator"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp" />

                <!-- Hint Button - Purple/Violet Gradient with Glow -->
                <Button
                    android:id="@+id/btn_hint"
                    android:layout_width="0dp"
                    android:layout_height="74dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    android:minHeight="0dp"
                    android:minWidth="0dp"
                    android:text="@string/hint"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textAllCaps="false"
                    android:fontFamily="sans-serif-black"
                    android:textColor="@android:color/white"
                    android:background="@drawable/button_hint_premium"
                    android:drawableTop="@drawable/ic_lightbulb"
                    android:drawableTint="@color/white"
                    android:drawablePadding="4dp"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:elevation="12dp"
                    android:stateListAnimator="@animator/button_animator"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp" />

                <!-- Menu Button - Green/Lime Gradient with Glow -->
                <Button
                    android:id="@+id/btn_menu"
                    android:layout_width="0dp"
                    android:layout_height="74dp"
                    android:layout_weight="1"
                    android:minHeight="0dp"
                    android:minWidth="0dp"
                    android:text="@string/menu"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textAllCaps="false"
                    android:fontFamily="sans-serif-black"
                    android:textColor="@android:color/white"
                    android:background="@drawable/button_menu_premium"
                    android:drawableTop="@drawable/ic_home"
                    android:drawableTint="@color/white"
                    android:drawablePadding="4dp"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:elevation="12dp"
                    android:stateListAnimator="@animator/button_animator"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp" />

            </LinearLayout>

        </FrameLayout>

    </LinearLayout>

</FrameLayout>

