<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <com.magicgrid.ui.CosmicBackgroundView
        android:id="@+id/cosmic_background"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/background_glass"
            android:elevation="8dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="16dp">

                <Button
                    android:id="@+id/btn_back"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@drawable/button_icon"
                    android:elevation="0dp"
                    android:padding="0dp"
                    android:text="←"
                    android:textColor="@color/primary"
                    android:textSize="24sp" />

                <TextView
                    android:id="@+id/difficulty_title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="@string/difficulty_page_title_placeholder"
                    android:textColor="@color/text_primary"
                    android:textSize="24sp"
                    android:textStyle="bold" />

                <Space
                    android:layout_width="48dp"
                    android:layout_height="48dp" />

            </LinearLayout>

        </FrameLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginTop="12dp"
            android:layout_marginEnd="12dp"
            android:background="@drawable/difficulty_detail_panel"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                android:id="@+id/difficulty_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:fontFamily="sans-serif-medium"
                android:text="@string/difficulty_choose_subtitle"
                android:textColor="@color/white_90"
                android:textSize="14sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/difficulty_stars"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/difficulty_stat_chip"
                    android:gravity="center"
                    android:padding="8dp"
                    android:text="@string/stars_label"
                    android:textColor="@color/white"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <Space
                    android:layout_width="6dp"
                    android:layout_height="1dp" />

                <TextView
                    android:id="@+id/difficulty_progress"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/difficulty_stat_chip"
                    android:gravity="center"
                    android:padding="8dp"
                    android:text="@string/progress_label"
                    android:textColor="@color/white"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <Space
                    android:layout_width="6dp"
                    android:layout_height="1dp" />

                <TextView
                    android:id="@+id/difficulty_unlocked"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/difficulty_stat_chip"
                    android:gravity="center"
                    android:padding="8dp"
                    android:text="@string/unlocked_label"
                    android:textColor="@color/white"
                    android:textSize="12sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btn_quick_play"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/button_quick_play"
                android:drawableStart="@drawable/ic_play"
                android:drawablePadding="10dp"
                android:fontFamily="sans-serif-black"
                android:gravity="center_vertical|start"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:text="@string/quick_play_label"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textSize="16sp" />

        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="6dp"
            android:text="@string/difficulty_detail_hint"
            android:textColor="@color/white_90"
            android:textSize="12sp" />

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingBottom="14dp">

            <LinearLayout
                android:id="@+id/level_map_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="8dp"
                android:paddingTop="2dp" />

        </ScrollView>

    </LinearLayout>

</FrameLayout>
