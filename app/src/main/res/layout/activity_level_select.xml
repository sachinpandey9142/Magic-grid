<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- COSMIC BACKGROUND -->
    <com.magicgrid.ui.CosmicBackgroundView
        android:id="@+id/cosmic_background"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- LEVEL SELECT CONTENT -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- TOP BAR (Glass Effect) -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/background_glass"
            android:elevation="8dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="16dp"
                android:gravity="center_vertical">

                <!-- Back Button -->
                <Button
                    android:id="@+id/btn_back"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:text="←"
                    android:textSize="24sp"
                    android:textColor="@color/primary"
                    android:background="@drawable/button_icon"
                    android:elevation="0dp"
                    android:padding="0dp" />

                <!-- Title -->
                <TextView
                    android:id="@+id/level_select_title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Difficulty Map"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary"
                    android:gravity="center" />

                <!-- Spacer for balance -->
                <Space
                    android:layout_width="48dp"
                    android:layout_height="48dp" />

            </LinearLayout>

        </FrameLayout>

        <TextView
            android:id="@+id/level_select_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="14dp"
            android:layout_marginBottom="8dp"
            android:text="@string/difficulty_choose_subtitle"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="@color/text_secondary"
            android:letterSpacing="0.04" />

        <!-- SCROLLABLE DIFFICULTY CARDS -->
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingBottom="20dp"
            android:scrollbarStyle="outsideOverlay"
            android:fadeScrollbars="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingTop="6dp"
                android:paddingBottom="10dp">

                <include
                    android:id="@+id/card_easy"
                    layout="@layout/view_difficulty_card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:background="@drawable/difficulty_card_easy" />

                <include
                    android:id="@+id/card_medium"
                    layout="@layout/view_difficulty_card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:background="@drawable/difficulty_card_medium" />

                <include
                    android:id="@+id/card_hard"
                    layout="@layout/view_difficulty_card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="14dp"
                    android:background="@drawable/difficulty_card_hard" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_marginTop="2dp"
                    android:layout_marginBottom="8dp"
                    android:fontFamily="sans-serif-medium"
                    android:letterSpacing="0.03"
                    android:text="@string/difficulty_hub_hint"
                    android:textColor="@color/white_90"
                    android:textSize="13sp" />

            </LinearLayout>

        </ScrollView>

    </LinearLayout>

</FrameLayout>