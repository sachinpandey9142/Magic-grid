<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Premium cosmic background with animated particles -->
    <com.magicgrid.ui.CosmicBackgroundView
        android:id="@+id/cosmic_background"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Main content on top of background -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="24dp">

        <!-- Top spacing -->
        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- Title section -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_marginBottom="32dp">

            <!-- App title with glow -->
            <TextView
                android:id="@+id/app_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/app_name"
                style="@style/TitleLarge"
                android:textColor="@color/white"
                android:fontFamily="sans-serif-black"
                android:letterSpacing="0.12"
                android:shadowColor="#AA7C3AED"
                android:shadowDx="0"
                android:shadowDy="0"
                android:shadowRadius="12"
                android:layout_marginBottom="12dp" />

            <!-- Subtitle -->
            <TextView
                android:id="@+id/app_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/menu_subtitle"
                android:textAlignment="center"
                android:textSize="16sp"
                android:textColor="@color/white_90"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.05"
                style="@style/Subtitle"
                android:layout_marginTop="8dp" />

        </LinearLayout>

        <!-- Buttons container -->
        <LinearLayout
            android:id="@+id/menu_button_panel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:layout_marginBottom="20dp"
            android:paddingLeft="16dp"
            android:paddingTop="16dp"
            android:paddingRight="16dp"
            android:paddingBottom="16dp"
            android:background="@drawable/menu_button_panel">

            <!-- PLAY Button - Primary with richer depth -->
            <Button
                android:id="@+id/btn_play"
                android:layout_width="280dp"
                android:layout_height="64dp"
                android:text="@string/play"
                android:textAllCaps="false"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="@color/white"
                android:fontFamily="sans-serif-black"
                android:letterSpacing="0.05"
                android:layout_marginBottom="14dp"
                android:background="@drawable/button_menu_primary_modern"
                android:elevation="12dp"
                android:stateListAnimator="@animator/button_animator"
                android:drawableStart="@drawable/ic_play"
                android:drawablePadding="14dp"
                android:gravity="center_vertical|start"
                android:paddingStart="24dp"
                android:paddingEnd="24dp" />

            <!-- LEVELS Button -->
            <Button
                android:id="@+id/btn_levels"
                android:layout_width="280dp"
                android:layout_height="56dp"
                android:text="@string/levels"
                android:textAllCaps="false"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/white"
                android:fontFamily="sans-serif-medium"
                android:layout_marginBottom="10dp"
                android:background="@drawable/button_menu_secondary_modern"
                android:elevation="5dp"
                android:stateListAnimator="@animator/button_animator"
                android:drawableStart="@drawable/ic_grid"
                android:drawablePadding="12dp"
                android:gravity="center_vertical|start"
                android:paddingStart="24dp"
                android:paddingEnd="24dp" />

            <!-- SETTINGS Button -->
            <Button
                android:id="@+id/btn_settings"
                android:layout_width="280dp"
                android:layout_height="56dp"
                android:text="@string/settings"
                android:textAllCaps="false"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/white"
                android:fontFamily="sans-serif-medium"
                android:layout_marginBottom="10dp"
                android:background="@drawable/button_menu_secondary_modern"
                android:elevation="5dp"
                android:stateListAnimator="@animator/button_animator"
                android:drawableStart="@drawable/ic_settings"
                android:drawablePadding="12dp"
                android:gravity="center_vertical|start"
                android:paddingStart="24dp"
                android:paddingEnd="24dp" />

            <!-- EXIT Button -->
            <Button
                android:id="@+id/btn_exit"
                android:layout_width="280dp"
                android:layout_height="56dp"
                android:text="@string/exit"
                android:textAllCaps="false"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/white"
                android:fontFamily="sans-serif-medium"
                android:background="@drawable/button_menu_secondary_modern"
                android:elevation="5dp"
                android:stateListAnimator="@animator/button_animator"
                android:drawableStart="@drawable/ic_exit"
                android:drawablePadding="12dp"
                android:gravity="center_vertical|start"
                android:paddingStart="24dp"
                android:paddingEnd="24dp" />

        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/menu_hint"
            android:textSize="13sp"
            android:textColor="@color/white_80"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.03"
            android:layout_marginBottom="8dp" />

        <!-- Bottom spacing -->
        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

    </LinearLayout>

</FrameLayout>

